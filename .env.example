# Copy to `.env` and adjust the values before running `docker compose up`.

# Secret used to sign/verify the JWT auth token (backend/src/routes/auth.routes.js,
# backend/src/middleware/auth.js). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Users are not configured here - create them with
# `docker compose exec backend npm run user:create` (see readme.md).

# Host ports docker-compose exposes the containers on.
BACKEND_PORT=3000
FRONTEND_PORT=80

# Optional: PAT for a private git source referenced as "ENV:WIKI_PAT" in
# backend/sources.config.json (see backend/sources.config.example.json).
# WIKI_PAT=

# Optional: paths (relative to the repo root) to a custom logo/favicon,
# bind-mounted over the generic defaults at container start (see
# docker-compose.yml). Leave unset to use the generic defaults shipped in
# frontend/public/logo.default.svg and favicon.default.svg.
# LOGO_FILE=./path/to/your-logo.svg
# FAVICON_FILE=./path/to/your-favicon.svg

# Set to "demo" to run this instance against the bundled example notes
# (demo/notes) instead of sources.config.json. Leave unset for normal use.
# MODE=demo
